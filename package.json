{
  "name": "pigeonfeed",
  "version": "1.0.0",
  "description": "A P2P social feed on PeerPigeon and freertc",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && npx wrangler@4 deploy",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "keywords": [
    "social",
    "p2p",
    "webrtc",
    "peerpigeon",
    "vue"
  ],
  "author": "Daniel Raeder",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "freertc": "^0.5.1",
    "peerpigeon": "^1.2.9",
    "pigeonidp": "^1.0.2",
    "unsea": "^3.1.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^7.3.7",
    "vue-tsc": "^3.1.0"
  }
}
