// PigeonFeed on Cloudflare: the app only (static, dist/). There is no server
// of its own: posts, friends and messages live on the PeerPigeon mesh and its
// storage servers (PigeonFS), and the relays are freertc's.
// Deploy with `npm run deploy` (builds, then uploads dist/).
{
  "name": "pigeonfeed",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // On feed.peer.ooo (a proxied DNS record on the peer.ooo zone), as chess.peer.ooo is.
  "routes": [{ "pattern": "feed.peer.ooo/*", "zone_name": "peer.ooo" }]
}
